{
  "project": {
    "name": "partner1-mock",
    "description": "partner1 endpoints for infrapay e2e (charge/capture/refund/consult/boleto/pix/pix_out/transfer/consultas de saida)"
  },
  "endpoints": [
    {
      "path": "/partner1/accounts",
      "method": "POST",
      "description": "CREATE_ACCOUNT",
      "statuses": [
        {
          "http_status": 201,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "account_id": "{{uuid}}",
              "token": "{{uuid}}",
              "api_key": "{{uuid}}",
              "status": "active",
              "created_at": "{{now}}"
            }
          }
        }
      ]
    },
    {
      "path": "/partner1/transactions",
      "method": "POST",
      "description": "CREATE_TRANSACTION (charge)",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "transaction_id": "{{request.body.payload.transaction_id}}",
              "gateway_id": "{{uuid}}",
              "status": "Confirmed",
              "authorized_amount": "{{request.body.payload.amount}}",
              "paid_amount": "{{request.body.payload.amount}}",
              "paid_at": "2026-01-01T00:00:00",
              "gateway_fee": 199,
              "metadata": {}
            }
          }
        }
      ]
    },
    {
      "path": "/partner1/transactions/capture",
      "method": "POST",
      "description": "CAPTURE_TRANSACTION \u2014 captura de cartao autorizado (captura total)",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "gateway_transaction_id": "{{request.body.payload.gateway_transaction_id}}",
              "status": "Confirmed",
              "captured_amount": "{{request.body.payload.amount}}",
              "captured_at": "2026-01-01T00:00:00",
              "gateway_fee": 0
            }
          }
        }
      ]
    },
    {
      "path": "/partner1/refunds",
      "method": "POST",
      "description": "REFUND",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "transaction_id": "{{request.body.payload.transaction_id}}",
              "gateway_refund_id": "{{uuid}}",
              "status": "Completed",
              "refunded_amount": "{{request.body.payload.amount}}",
              "refunded_at": "2026-01-01T00:00:00"
            }
          }
        }
      ]
    },
    {
      "path": "/partner1/transactions/query",
      "method": "POST",
      "description": "QUERY_TRANSACTION (consult) \u2014 POST porque GET nao encaminha payload",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "gateway_transaction_id": "{{request.body.payload.gateway_transaction_id}}",
              "status": "Confirmed",
              "paid_amount": 10000,
              "paid_at": "2026-01-01T00:00:00",
              "last_updated": "2026-01-01T00:00:00",
              "gw_fee_amount": 199,
              "gw_interest": 0
            }
          }
        }
      ]
    },
    {
      "path": "/partner1/boletos",
      "method": "POST",
      "description": "CREATE_BOLETO",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "transaction_id": "{{request.body.payload.transaction_id}}",
              "boleto_url": "https://partner1.mock/boleto/{{uuid}}",
              "barcode": "34191790010104351004791020150008291070026000",
              "digitable_line": "34191.79001 01043.510047 91020.150008 2 91070026000",
              "due_date": "2026-12-31",
              "status": "Generated",
              "amount": "{{request.body.payload.amount}}",
              "metadata": {}
            }
          }
        }
      ]
    },
    {
      "path": "/partner1/pix",
      "method": "POST",
      "description": "CREATE_PIX",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "transaction_id": "{{request.body.payload.transaction_id}}",
              "qr_code": "{{uuid}}",
              "qr_code_base64": "aGVsbG8=",
              "emv": "00020126580014BR.GOV.BCB.PIX",
              "expires_at": "2026-01-01T00:00:00",
              "status": "Generated",
              "amount": "{{request.body.payload.amount}}",
              "metadata": {}
            }
          }
        }
      ]
    },
    {
      "path": "/partner1/pix_out",
      "method": "POST",
      "description": "PIX_OUT",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "withdrawal_id": "{{request.body.payload.withdrawal_id}}",
              "gateway_id": "{{uuid}}",
              "status": "Completed",
              "fee": 350,
              "metadata": {}
            }
          }
        }
      ]
    },
    {
      "path": "/partner1/transfers",
      "method": "POST",
      "description": "TRANSFER",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "withdrawal_id": "{{request.body.payload.withdrawal_id}}",
              "gateway_id": "{{uuid}}",
              "status": "Processing",
              "fee": 350,
              "metadata": {}
            }
          }
        }
      ]
    },
    {
      "path": "/partner1/bills/consult",
      "method": "POST",
      "description": "CONSULT_BILL",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "barcode": "{{request.body.payload.barcode}}",
              "digitable_line": "34191.79001 01043.510047 91020.150008 2 91070026000",
              "assignee_name": "Cedente Mock",
              "assignee_document": "11222333000181",
              "due_date": "2026-12-31",
              "original_amount": 10000,
              "fees": 0,
              "discount": 0,
              "total_amount": 10000,
              "is_payable": true,
              "metadata": {}
            }
          }
        }
      ]
    },
    {
      "path": "/partner1/bills/pay",
      "method": "POST",
      "description": "PAY_BILL",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "payment_id": "{{request.body.payload.payment_id}}",
              "gateway_id": "{{uuid}}",
              "status": "Completed",
              "amount": "{{request.body.payload.amount}}",
              "scheduled_at": null,
              "paid_at": "2026-01-01T00:00:00",
              "metadata": {}
            }
          }
        }
      ]
    },
    {
      "path": "/partner1/pix/static",
      "method": "POST",
      "description": "CREATE_STATIC_PIX_QR",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "external_key": "{{uuid}}",
              "qr_code_emv": "00020126580014BR.GOV.BCB.PIX",
              "qr_code_url": "https://partner1.mock/qr/{{uuid}}",
              "pix_key": "pix-key-mock@partner1.test"
            }
          }
        }
      ]
    },
    {
      "path": "/partner1/pix/static/deactivate",
      "method": "POST",
      "description": "DEACTIVATE_STATIC_PIX_QR",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {}
          }
        }
      ]
    },
    {
      "path": "/partner1/accounts/status",
      "method": "POST",
      "description": "QUERY_ACCOUNT \u2014 consulta ativa de status da subconta",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "is_verified": true,
              "status": "approved",
              "reason": null
            }
          }
        }
      ]
    },
    {
      "path": "/partner2/accounts",
      "method": "POST",
      "description": "CREATE_ACCOUNT (partner2)",
      "statuses": [
        {
          "http_status": 201,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "account_id": "{{uuid}}",
              "token": "{{uuid}}",
              "api_key": "{{uuid}}",
              "status": "pending",
              "created_at": "{{now}}"
            }
          }
        }
      ]
    },
    {
      "path": "/partner2/accounts/status",
      "method": "POST",
      "description": "QUERY_ACCOUNT (partner2) \u2014 sempre em analise",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "is_verified": false,
              "status": "in_analysis",
              "reason": null
            }
          }
        }
      ]
    },
    {
      "path": "/partner1/documents/status",
      "method": "POST",
      "description": "QUERY_DOCUMENT \u2014 documento RECUSADO (o unico desfecho que o fluxo aplica)",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "document_id": "{{request.body.payload.document_id}}",
              "status": "rejected",
              "document_type": "identity",
              "reason": "documento ilegivel"
            }
          }
        }
      ]
    },
    {
      "path": "/partner2/documents/status",
      "method": "POST",
      "description": "QUERY_DOCUMENT \u2014 documento APROVADO (contradiz um webhook de recusa)",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "document_id": "{{request.body.payload.document_id}}",
              "status": "approved",
              "document_type": "identity",
              "reason": null
            }
          }
        }
      ]
    },
    {
      "path": "/partner1/withdrawals/query",
      "method": "POST",
      "description": "QUERY_WITHDRAWAL - consulta de saque (pix out/ted) pelo nosso id; concluido",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "gateway_id": "gw_wd_{{request.body.payload.reference_id}}",
              "status": "Completed",
              "failure_reason": null
            }
          }
        }
      ]
    },
    {
      "path": "/partner1/bill-payments/query",
      "method": "POST",
      "description": "QUERY_BILL_PAYMENT - consulta de pagamento de conta pelo nosso id; concluido",
      "statuses": [
        {
          "http_status": 200,
          "percentage": 100,
          "model": {
            "success": true,
            "data": {
              "gateway_id": "gw_bp_{{request.body.payload.reference_id}}",
              "status": "Completed",
              "failure_reason": null
            }
          }
        }
      ]
    }
  ]
}
