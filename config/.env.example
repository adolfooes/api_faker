# Copie para config/.env e preencha. O .env real NAO vai para o git.
#
#   cp config/.env.example config/.env

# ---- Postgres do compose local ----
# Banco efemero que sobe junto pelo docker-compose-local.yml; estes valores
# nao saem da maquina, entao ficam preenchidos para o `make up` funcionar
# sem edicao.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev123
POSTGRES_DB=api_faker_dev
FAKER_DATABASE_URL=postgres://postgres:dev123@db:5432/api_faker_dev?sslmode=disable

# ---- Assinatura dos tokens ----
# Vazio ou "your_secret_key" faz o servico avisar no boot (cmd/main.go:16).
# Gere com: openssl rand -hex 32
JWT_SECRET_KEY=

# ---- Conta usada pelo seed de cenarios (make seed-kyc) ----
# A senha precisa de 8+ caracteres com maiuscula, minuscula, numero e simbolo
# (internal/api/handler/account.go:45-69).
SEED_EMAIL=seed@apifaker.dev
SEED_PASSWORD=
